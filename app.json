{
  "expo": {
    "name": "TrackBack",
    "slug": "trackback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F9"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F8F9"
      },
      "package": "com.trackback.campus"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "TrackBack needs access to your photos to upload item images."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "trackback",
    "extra": {
      "eas": {
        "projectId": "eb8adf0b-fff6-4331-81e6-8c3cebdcaf7b"
      }
    }
  }
}
